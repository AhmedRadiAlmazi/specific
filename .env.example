# ==============================================================================
# Mouin (مُعين) — Production Environment Variables Template (.env.example)
# ==============================================================================
# IMPORTANT: Copy this file to .env and configure all variables securely.
# NEVER commit real secrets or production credentials to version control.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=production
LOG_LEVEL=INFO

# Delivery Layer / REST API Port & Host
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (PostgreSQL 16+)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://mouin_app_user:CHANGE_ME_STRONG_PASSWORD@postgres.internal:5432/mouin_production_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Security & Authentication (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_64_CHAR_HEX_SECRET_FOR_PRODUCTION_ONLY_XYZ1234567890
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated list of exact domains — NO WILDCARD in production)
ALLOWED_ORIGINS=https://app.mouin.io,https://admin.mouin.io

# Request Limits & Rate Limiting (Bytes)
MAX_REQUEST_BODY_BYTES=10485760
DEFAULT_PAGE_LIMIT=50
MAX_PAGE_LIMIT=100
MAX_SYNC_BATCH_SIZE=100

# Backup & Recovery Configuration
BACKUP_STORAGE_PATH=/var/backups/mouin
BACKUP_RETENTION_DAYS=30
