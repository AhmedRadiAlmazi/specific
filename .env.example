# =============================================================================
# مشروع «مُعين» (Mouin) — Production Environment Configuration Template (.env.example)
# ALL VALUES IN THIS FILE ARE PLACEHOLDERS. DO NOT STORE REAL SECRETS IN GIT.
# =============================================================================

APP_ENV=production
APP_NAME=مُعين (Mouin) API
APP_VERSION=1.0.0
PORT=8000
HOST=0.0.0.0

# Database Connection (PostgreSQL Production Instance)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require

# Cryptographic Keys (Min 32 random characters in production)
JWT_SECRET_KEY=<GENERATE_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS & Security
ALLOWED_ORIGINS=https://app.mouin.local,https://admin.mouin.local
LOG_LEVEL=INFO

# Rate Limiting & Resource Bounds
MAX_REQUEST_BODY_BYTES=10485760
MAX_SYNC_BATCH_SIZE=100
